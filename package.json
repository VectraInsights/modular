{
  "name": "obliquo-studio",
  "version": "1.0.0",
  "description": "Oblíquo Studio — Planejador de cômodos 2D + 3D — app de PC (Electron). Só digite as medidas e o desenho sai sozinho.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.obliquo.studio",
    "productName": "Oblíquo Studio",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": ["portable", "nsis"],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oblíquo Studio"
    },
    "portable": {
      "artifactName": "ObliquoStudio-${version}-portable.${ext}"
    }
  }
}
